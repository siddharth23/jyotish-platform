# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored — never commit it.
# hcloud_token is better passed as TF_VAR_hcloud_token in your shell than written here at all.

ssh_public_key    = "ssh-ed25519 AAAA... you@yourmachine"
allowed_ssh_cidrs = ["203.0.113.4/32"] # replace with your actual IP(s)
server_type       = "cx23"
location          = "fsn1"
enable_backups    = true
