# Copy to .env and fill in. NEVER commit .env.

# --- Environment ---
NODE_ENV=development
LOG_LEVEL=debug
API_BASE_URL=http://localhost:3000

# --- Database (EU region in all deployed environments) ---
DATABASE_URL=postgresql://jyotish:jyotish@localhost:5432/jyotish_dev
REDIS_URL=redis://localhost:6379

# --- Encryption ---
# Envelope encryption for birth data. Managed KMS in deployed environments.
KMS_KEY_ID=
ENCRYPTION_KEY_LOCAL_DEV_ONLY=

# --- Stripe (test keys only in dev) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Object storage ---
S3_BUCKET_REPORTS=
S3_REGION=eu-central-1

# --- Email ---
SMTP_URL=
EMAIL_FROM=

# --- Push ---
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=

# --- LLM drafting assistant (EU-hosted or DPA-covered) ---
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# --- Geocoding ---
GEOCODING_API_KEY=

# --- Feature flags ---
FEATURE_PAID_EVALUATION_ENABLED=true
FEATURE_CAREER_ANALYSIS_ENABLED=true
